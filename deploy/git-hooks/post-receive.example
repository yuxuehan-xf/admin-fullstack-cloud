#!/bin/bash
# 用法：把本文件复制到裸仓库的 hooks 目录并改名、加执行权限
#   cp deploy/git-hooks/post-receive.example /home/ubuntu/repos/admin-fullstack-cloud.git/hooks/post-receive
#   chmod +x /home/ubuntu/repos/admin-fullstack-cloud.git/hooks/post-receive
# 适用场景：虚拟机访问不了 GitHub 时，用"自建裸仓库 + 钩子"实现 push 即部署
set -e

WORK_TREE=/home/ubuntu/admin-fullstack-cloud
GIT_DIR=/home/ubuntu/repos/admin-fullstack-cloud.git

echo "===== 开始自动部署 $(date '+%F %T') ====="

git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f main

cd "$WORK_TREE"
docker compose -f docker-compose-all.yml config > /dev/null
echo "compose 文件校验通过"

docker compose -f docker-compose-all.yml up -d --build

sleep 15
docker exec fastapi-admin python seed_data.py || true

echo "===== 部署完成 $(date '+%F %T') ====="
docker ps
