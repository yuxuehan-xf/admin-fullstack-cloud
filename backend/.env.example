# ===== 使用方式 =====
# 在服务器上执行：cp .env.example .env
# 注意：容器内通过 compose 服务名 db 访问 MariaDB，DB_HOST 必须写 db，不能写 IP
# 本文件可以提交到 GitHub；真正的 .env 已被 .gitignore 排除，不会上传

# 数据库配置
DB_HOST=db
DB_PORT=3306
DB_USER=admin_user
DB_PASSWORD=Admin@2026
DB_NAME=admin_db

# JWT认证配置（生产环境请改成自己的随机字符串）
JWT_SECRET_KEY=admin_2026_secret_888
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOUR=2

# 服务监听配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
